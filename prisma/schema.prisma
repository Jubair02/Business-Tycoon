generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  cash       Float    @default(500000)
  netWorth   Float    @default(500000)
  level      Int      @default(1)
  experience Int     @default(0)
  avatar     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Phase 2: AI Competitor Fields
  isAI         Boolean  @default(false)
  personality  String?  // CONSERVATIVE | BALANCED | AGGRESSIVE | TRADER | EXPANSIONIST
  lastAction   String?  // Last AI action taken (e.g., BUY_INVENTORY, CHANGE_PRICE)
  lastActionAt Int     @default(0)  // Game day when last action was taken (for cooldowns)

  businesses    Business[]
  gameLogs      GameLog[]
  loans         Loan[]

  @@index([isAI])
}

model Business {
  id            String   @id @default(cuid())
  playerId      String
  type          String
  city          String
  name          String
  level         Int      @default(1)
  reputation    Float    @default(50)
  cash          Float    @default(0)
  dailyRevenue  Float    @default(0)
  dailyExpense  Float    @default(0)
  dailyProfit   Float    @default(0)
  dailyCOGS     Float    @default(0)
  dailyCustomers Int     @default(0)
  totalRevenue  Float    @default(0)
  totalProfit   Float    @default(0)
  healthScore   Int      @default(50)

  // Phase 3: Customer Experience Fields
  satisfactionScore   Float    @default(50)   // 0-100, overall customer satisfaction
  loyaltyScore        Float    @default(0)    // 0-100, customer loyalty index
  repeatCustomerRate  Float    @default(0)    // 0-1, fraction of repeat customers
  npsScore            Float    @default(0)    // -100 to 100, Net Promoter Score
  totalReviews        Int      @default(0)    // Count of all reviews
  avgReviewRating     Float    @default(0)    // 1-5, average review score

  // Phase 4: Marketing Fields
  brandAwareness      Float    @default(0)    // 0-100, brand awareness from marketing

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player      Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  inventories Inventory[]
  employees   Employee[]
  logs        GameLog[]
  metrics     BusinessMetric[]
  reviews     CustomerReview[]
  campaigns   MarketingCampaign[]

  @@index([playerId])
}

model Product {
  id         String  @id @default(cuid())
  name       String  @unique
  category   String
  basePrice  Float
  baseDemand Float
  icon       String?
}

model Inventory {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  productName   String
  category      String
  quantity      Int      @default(0)
  purchasePrice Float
  sellPrice     Float
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Employee {
  id          String   @id @default(cuid())
  businessId  String
  role        String
  name        String
  salary      Float
  skill       Float
  efficiency  Float
  hiredAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model MarketPrice {
  id               String   @id @default(cuid())
  productName      String
  city             String
  priceMultiplier  Float   @default(1)
  demandMultiplier Float   @default(1)
  updatedAt        DateTime @default(now())

  @@unique([productName, city])
}

model GameEvent {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String
  effects     String
  active      Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime

  @@index([active])
}

model GameLog {
  id         String   @id @default(cuid())
  playerId   String?
  businessId String?
  type       String
  message    String
  amount     Float?
  createdAt  DateTime @default(now())

  player   Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@index([businessId])
}

model NewsArticle {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  icon      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model GameState {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Loan {
  id            String   @id @default(cuid())
  playerId      String
  amount        Float
  interestRate  Float    @default(0.05)
  remainingDebt Float
  dailyPayment  Float
  daysRemaining Int
  totalInterest Float    @default(0)
  status        String   @default("ACTIVE")
  takenAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ---- Phase 1: Historical Business Metrics ----
// Tracks daily performance for analytics, charts, and trend analysis.
model BusinessMetric {
  id         String   @id @default(cuid())
  businessId String
  gameDay    Int
  revenue    Float    @default(0)
  expenses   Float    @default(0)
  profit     Float    @default(0)
  cogs       Float    @default(0)
  customers  Int      @default(0)
  reputation Float    @default(50)

  // Phase 3: Customer Experience Metrics
  satisfaction  Float    @default(50)
  loyalty       Float    @default(0)
  nps           Float    @default(0)

  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, gameDay])
  @@index([businessId, gameDay])
}

// ---- Phase 3: Customer Reviews ----
// Stores generated customer reviews for CX analytics
model CustomerReview {
  id          String   @id @default(cuid())
  businessId  String
  gameDay     Int
  rating      Int      // 1-5 star rating
  sentiment   String   // POSITIVE | NEUTRAL | NEGATIVE
  category    String   // PRICE | SERVICE | QUALITY | STOCKOUT | CLEANLINESS | WAIT_TIME
  comment     String   // Generated review text
  segment     String   // BUDGET | REGULAR | PREMIUM | TOURIST
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, gameDay])
}

// ---- Phase 4: Marketing Campaigns ----
model MarketingCampaign {
  id          String   @id @default(cuid())
  businessId  String
  playerId    String
  
  // Campaign definition
  name        String                    // Player-given campaign name
  channel     String                    // SOCIAL_MEDIA | FACEBOOK_ADS | LOCAL_ADS | INFLUENCER | BILLBOARD | TV_MEDIA
  targetSegment String?                // BUDGET | REGULAR | PREMIUM | TOURIST | null (=all segments)
  
  // Budget & Duration
  dailyBudget  Float                   // Taka per day
  totalBudget  Float                   // Total campaign budget
  duration     Int                     // Campaign duration in game days
  startDay     Int                     // Game day campaign started
  endDay       Int                     // Game day campaign ends
  
  // Status
  status       String   @default("ACTIVE")  // ACTIVE | PAUSED | COMPLETED | CANCELLED
  
  // Performance Tracking (updated each tick)
  daysRun      Int      @default(0)         // Number of days campaign has run
  totalSpend   Float    @default(0)         // Total taka spent so far
  totalReach   Float    @default(0)         // Total impressions/reach
  totalConversions Int   @default(0)        // Total customers acquired
  revenueInfluenced Float @default(0)       // Revenue attributed to this campaign
  
  // Effectiveness (calculated)
  effectiveness Float  @default(0)          // 0-1 effectiveness score
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  metrics  CampaignMetric[]
  
  @@index([businessId])
  @@index([playerId])
  @@index([businessId, status])
}

// ---- Phase 4: Campaign Daily Metrics ----
model CampaignMetric {
  id          String   @id @default(cuid())
  campaignId  String
  gameDay     Int
  
  dailySpend     Float   @default(0)
  dailyReach     Float   @default(0)
  dailyConversions Int   @default(0)
  revenueInfluenced Float @default(0)
  demandModifier  Float   @default(1)   // How much demand was boosted this day
  
  createdAt  DateTime @default(now())
  
  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  @@unique([campaignId, gameDay])
  @@index([campaignId, gameDay])
}
