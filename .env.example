# ---- Database ----
# Any PostgreSQL connection string (the project runs against Neon).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Sessions ----
# Signing secret for the legacy guest cookie. Minimum 32 characters;
# generate with: openssl rand -hex 32
SESSION_SECRET=""

# ---- Google sign-in (optional) ----
# Without these the game still works — the "Continue with Google" button is
# simply hidden and players sign up with an email and password.
#
# Setup:
#   1. https://console.cloud.google.com/apis/credentials → Create credentials
#      → OAuth client ID → Web application.
#   2. Authorised redirect URI: <your origin>/api/auth/google/callback
#      e.g. http://localhost:3000/api/auth/google/callback
#   3. Paste the client id and secret below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public origin of this deployment. Required in production: behind a reverse
# proxy the app sees an internal host, which would build a redirect URI that
# Google rejects. Leave unset in local development.
APP_URL=""

# ---- Game clock ----
# The world advances on the server, not in the browser. The Next.js server
# starts an in-process clock on boot (see src/instrumentation.ts).
#
# How often a game day passes, in milliseconds. Clamped to 5s..1h; an
# unparseable value falls back to 60000 rather than freezing the game.
GAME_TICK_INTERVAL_MS="60000"

# Set to "off" to stop THIS process running the clock — use that when an
# external cron drives /api/game/tick instead, or on a process that should
# never advance the world. Anything else (or unset) means on.
GAME_TICK_SCHEDULER=""

# Shared secret for driving /api/game/tick from outside the app. One tick moves
# the day for every player and every AI competitor, so the endpoint is not
# player-callable: without this set it is refused outright in production.
# Generate with: openssl rand -hex 32
#
#   curl -X POST https://<origin>/api/game/tick -H "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# ---- Push notifications (optional) ----
# Without these push is simply unavailable: the Settings toggle explains that
# rather than failing, and the game is unaffected.
#
# Generate a key pair with:
#   npx web-push generate-vapid-keys
#
# The public key is handed to browsers by design; the private key signs the
# requests to the push service and must never reach the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact address the push service can reach you at, as a mailto: or https: URL.
VAPID_SUBJECT="mailto:support@example.com"

# ---- Payments (optional) ----
# Which payment provider handles cosmetic and season-pass purchases.
# "sandbox" (the default) settles instantly without any network call, which is
# what local development and tests use. Setting anything else requires that
# provider's credentials below — see src/lib/commerce/providers.
PAYMENT_PROVIDER="sandbox"
# SSLCommerz is the usual choice for Bangladesh (it fronts bKash, Nagad and
# card payments); Stripe is here for markets it does not cover.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
STRIPE_SECRET_KEY=""

# ---- Rewarded video (optional) ----
# Which ad network serves rewarded video. "none" (the default) hides every
# rewarded placement rather than showing a button that cannot pay out.
AD_PROVIDER="none"
AD_NETWORK_APP_ID=""
# Shared secret the network signs its server-side reward callbacks with. Without
# it a reward callback is refused: an unverified callback is a free-money hole.
AD_SSV_SECRET=""

# ---- Brand sponsorship (optional) ----
# Bearer token a sponsor uses to read their own campaign report at
# /api/sponsors/<slug>/report. Unset means the endpoint is refused outright
# rather than left open — a campaign report is commercial data.
# Generate with: openssl rand -hex 32
SPONSOR_REPORT_TOKEN=""

# ---- Analytics ----
# Onboarding funnel, D1/D7/D30 retention, session length and drop-off, computed
# in-repo from an event table rather than shipped to a third party. No personal
# data is ever recorded — see src/lib/analytics/track.ts for the deny-list.
#
# Set to "1" to stop every analytics write without touching a call site.
ANALYTICS_DISABLED=""
# Bearer token for GET /api/analytics/report. Unset means the endpoint refuses
# rather than opening — a missing environment variable must never be the thing
# that publishes the numbers.
# Generate with: openssl rand -hex 32
ANALYTICS_REPORT_TOKEN=""
